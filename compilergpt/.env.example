# CompilerGPT Universe — Environment Variables Example
# Copy this file to .env.local for local development or configure in Vercel project settings.

# (Optional) Anthropic Claude API Key for natural language AI Compiler Investigator explanations.
# If omitted, the AI Investigator automatically falls back to grounded, rule-based compiler artifact explanations.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# (Optional) Enable the /api/test endpoint in production (disabled by default for security).
# Set to "true" only in CI pipelines or trusted environments. Never enable on public deployments.
# ENABLE_TEST_ENDPOINT=true
